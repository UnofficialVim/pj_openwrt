#!/bin/sh /etc/rc.common
START=11
USE_PROCD=1

LM63_BUS=0
LM63_ADDR=0x4c

start_service() {
	# Clear the spin-up bits (reg 0x4b, low 5) so it starts straight at the commanded duty. Needs i2c-tools.
	if command -v i2cget >/dev/null; then
		v=$(i2cget -f -y $LM63_BUS $LM63_ADDR 0x4b) && \
			i2cset -f -y $LM63_BUS $LM63_ADDR 0x4b $((v & ~0x1f)) || \
			logger -t alien-fan "could not clear LM63 spin-up"
	fi
	procd_open_instance
	procd_set_param command /usr/sbin/alien-fan
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	# failsafe: set fan to full speed
	for h in /sys/class/hwmon/hwmon*; do
		[ "$(cat $h/name)" = lm63 ] && echo 255 > $h/pwm1
	done
}
